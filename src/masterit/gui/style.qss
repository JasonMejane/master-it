QWidget {
    color: $text;
}

QMainWindow, QDialog {
    background: $window;
}

QToolTip {
    background: $surface;
    color: $text;
    border: 1px solid $border;
    padding: 4px 6px;
}

QTabWidget::pane {
    border: none;
    border-top: 1px solid $border;
}

QTabBar::tab {
    background: transparent;
    color: $muted;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 18px;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: $text;
}

QTabBar::tab:selected {
    color: $text;
    border-bottom-color: $accent;
}

QFrame#section {
    background: $surface;
    border: 1px solid $border;
    border-radius: 8px;
}

QLabel#sectionTitle {
    color: $muted;
    font-weight: 600;
}

QLabel[muted="true"] {
    color: $muted;
}

QLabel#cover {
    background: $field;
    border: 1px dashed $border;
    border-radius: 6px;
    color: $muted;
}

QPushButton, QToolButton {
    background: $surface;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 3px 10px;
}

QPushButton:hover, QToolButton:hover {
    background: $hover;
}

QPushButton:pressed, QToolButton:pressed {
    background: $border;
}

QPushButton:disabled, QToolButton:disabled {
    color: $muted;
    background: transparent;
}

QPushButton[role="primary"], QPushButton:default {
    background: $accent;
    border-color: $accent;
    color: $accent_text;
    font-weight: 600;
}

QPushButton[role="primary"]:hover, QPushButton:default:hover {
    background: $accent_hover;
    border-color: $accent_hover;
}

QPushButton[role="primary"]:pressed, QPushButton:default:pressed {
    background: $accent_pressed;
    border-color: $accent_pressed;
}

QPushButton[role="primary"]:disabled, QPushButton:default:disabled {
    background: transparent;
    border-color: $border;
    color: $muted;
}

QLineEdit, QPlainTextEdit, QTextEdit, QComboBox {
    background: $field;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 2px 6px;
    selection-background-color: $accent;
    selection-color: $accent_text;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QComboBox:focus {
    border-color: $accent;
}

QLineEdit:disabled, QPlainTextEdit:disabled, QComboBox:disabled {
    color: $muted;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    background: transparent;
    width: 20px;
}

QComboBox::down-arrow {
    image: url($combo_arrow);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background: $surface;
    border: 1px solid $border;
    selection-background-color: $accent;
    selection-color: $accent_text;
}

QTableView {
    background: $field;
    alternate-background-color: $alternate;
    border: 1px solid $border;
    border-radius: 6px;
    gridline-color: $border;
    selection-background-color: $accent;
    selection-color: $accent_text;
}

QHeaderView {
    background: $surface;
    border: none;
}

QCheckBox::indicator, QAbstractItemView::indicator {
    width: 14px;
    height: 14px;
    background: $field;
    border: 1px solid $muted;
    border-radius: 3px;
}

QCheckBox::indicator:checked, QAbstractItemView::indicator:checked {
    background: $accent;
    border-color: $accent;
    image: url($check_mark);
}

QAbstractItemView::indicator:checked:selected {
    border-color: $accent_text;
}

QCheckBox::indicator:disabled, QAbstractItemView::indicator:disabled {
    border-color: $border;
}

QHeaderView::section {
    background: $surface;
    color: $muted;
    border: none;
    border-bottom: 1px solid $border;
    border-right: 1px solid $border;
    padding: 5px 8px;
    font-weight: 600;
}

QTableCornerButton::section {
    background: $surface;
    border: none;
}

QSplitter::handle {
    background: transparent;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    border: none;
    margin: 0;
}

QScrollBar:vertical {
    width: 10px;
}

QScrollBar:horizontal {
    height: 10px;
}

QScrollBar::handle {
    background: $border;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    min-height: 24px;
}

QScrollBar::handle:horizontal {
    min-width: 24px;
}

QScrollBar::handle:hover {
    background: $muted;
}

QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    width: 0;
    height: 0;
}

QMenu {
    background: $surface;
    border: 1px solid $border;
    padding: 4px;
}

QMenu::item {
    padding: 5px 16px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: $accent;
    color: $accent_text;
}
